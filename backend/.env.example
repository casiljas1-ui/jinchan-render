# Copy to backend/.env. Never commit backend/.env.
AI_PROVIDER=minimax
MINIMAX_API_KEY=replace_with_your_key
MINIMAX_GROUP_ID=
MINIMAX_TTS_MODEL=speech-2.8-hd
MINIMAX_TEXT_MODEL=MiniMax-M2.7
MINIMAX_VOICE_ID=male-qn-qingse

DATABASE_URL=sqlite:///./database/jinchan.db
VOICE_DIR=./storage/audio/calls/generated
RECORDING_DIR=./storage/audio/voices/originals
CLONED_VOICE_DIR=./storage/audio/voices/cloned

# Usually leave empty when ffmpeg.exe is already in PATH.
FFMPEG_PATH=
